FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Cài torch bản CPU trước: bản mặc định trên Linux kèm CUDA, làm image nặng thêm nhiều GB.
COPY requirements.txt .
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

# Vercel không có ổ đĩa lâu dài nên model được đóng gói sẵn trong image.
RUN hf download sHunOrinn/social-comment-models --local-dir models \
    && rm -rf models/.cache \
    && for task in toxicity hate_speech sentiment; do \
           test -f "models/$task/model.safetensors" || { echo "Thieu model: $task" >&2; exit 1; }; \
       done

COPY app ./app

ENV HF_HUB_OFFLINE=1

# Vercel mặc định dùng cổng 80, có thể đổi bằng biến PORT.
# Địa chỉ Vercel là công khai nên không có API key thì dừng ngay.
CMD ["sh", "-c", ": \"${AI_SERVICE_API_KEY:?Thieu bien AI_SERVICE_API_KEY}\"; exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
